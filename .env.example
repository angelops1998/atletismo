# Plantilla de configuración. En el servidor copiala a .env y completá los valores.
#   cp .env.example .env  &&  nano .env
# NUNCA subas el .env real al repo (ya está en .gitignore).

# --- Base de datos ---
# En DESARROLLO, el Postgres de tu máquina:
DATABASE_URL=postgresql://atletismo:CAMBIAR_PASSWORD@127.0.0.1:5432/atletismo
#
# En PRODUCCIÓN esto no se usa: la app corre en Render y las variables se cargan
# en su panel (ver DEPLOY.md). La única vez que vas a poner acá la cadena de
# Supabase es para crear el profesor, y después la volvés a dejar como estaba.
# Tiene que ser la del *Session pooler*, no la conexión directa:
#   postgresql://postgres.REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Clave de firma (JWT + CSRF) ---
# Generá una NUEVA para producción (no reutilices la de desarrollo):
#   python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_NUEVA_DE_128_HEX

# --- Sesión ---
# La sesión es deslizante: se renueva sola mientras la persona usa la app, así que
# este valor es cuánto puede estar SIN entrar antes de tener que loguearse de nuevo.
# 86400 = 60 días. No lo bajes: los atletas entran una vez por semana y si les pide
# la contraseña cada vez, dejan de cargar el parte.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=86400

# --- Seguridad de cookies ---
# En producción DEBE ser true. En Render ya viene así desde render.yaml: acá
# queda en false porque en tu máquina la app corre por http y con true no
# podrías ni entrar (el navegador descarta la cookie de sesión).
HTTPS_ONLY=false

# --- Datos del club (se muestran en la página pública) ---
# En producción se cargan en el panel de Render, no acá.
CLUB_NOMBRE=Club de Atletismo
CLUB_TELEFONO=
CLUB_WHATSAPP=
CLUB_EMAIL=
CLUB_DIRECCION=
CLUB_INSTAGRAM=
CLUB_FACEBOOK=
